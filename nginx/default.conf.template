server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Cloud Run は外側で HTTPS 終端し、コンテナは :8080 で待ち受ける。
    # ディレクトリへのリダイレクト（/about → /about/）で Location に :8080 を出さない。
    absolute_redirect off;
    port_in_redirect off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/xml
        application/xml
        application/javascript
        application/json
        application/ld+json
        image/svg+xml;

    # ハッシュ付きビルド成果物のみ長期キャッシュ（HTML 等は対象外）
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
