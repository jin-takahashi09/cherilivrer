---
import Header from './Header.astro';
import heroImg from '../../assets/img/hero.jpg';
---

<section id="home" class="scroll-mt-20 md:scroll-mt-24 w-full pt-14 md:pt-24" aria-label="トップ">
	<Header />
	<div class="relative overflow-hidden lg:h-[calc(100vh-6rem)]">
		<img
			src={heroImg.src}
			alt="Cheri Livrer ヒーロー画像"
			width={heroImg.width}
			height={heroImg.height}
			class="block h-auto w-full lg:h-full lg:w-full lg:object-cover lg:object-center"
			fetchpriority="high"
			decoding="async"
		/>
	</div>
</section>
