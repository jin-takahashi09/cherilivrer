---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layouts/Header.astro';
import Footer from '../components/layouts/footer.astro';
import OnlineStore from '../components/layouts/onlinestore.astro';
import type { ImageMetadata } from 'astro';
import collectionBalloonImg1 from '../assets/img/collection/collection-balloon-img1.jpg';
import collectionBalloonImg2 from '../assets/img/collection/collection-balloon-img2.jpg';
import collectionBalloonImg3 from '../assets/img/collection/collection-balloon-img3.jpg';
import collectionBalloonImg4 from '../assets/img/collection/collection-balloon-img4.jpg';
import collectionBalloonImg5 from '../assets/img/collection/collection-balloon-img5.jpg';
import collectionFlowerImg1 from '../assets/img/collection/collection-flower-img1.jpg';
import collectionFlowerImg2 from '../assets/img/collection/collection-flower-img2.jpg';
import collectionFlowerImg3 from '../assets/img/collection/collection-flower-img3.jpg';
import collectionFlowerImg4 from '../assets/img/collection/collection-flower-img4.jpg';
import collectionSeasonImg1 from '../assets/img/collection/collection-season-img1.jpg';
import collectionSeasonImg2 from '../assets/img/collection/collection-season-img2.jpg';
import collectionSeasonImg3 from '../assets/img/collection/collection-season-img3.jpg';

const title = 'Collection | Cheri Livrer';
const description =
	'Cheri Livrer のバルーン・フラワー・シーズンギフトなどのコレクション。横スクロールでラインナップをご覧いただけます。';

const baseShop = 'https://cherilivrer.base.shop';
const lineShop = 'https://lin.ee/m3M0UIf';

type Item = {
	seed?: string;
	image?: ImageMetadata;
	title: string;
	alt: string;
	desc: string[];
};

type Category = {
	id: string;
	num: string;
	title: string;
	intro: string[];
	items: Item[];
};

const categories: Category[] = [
	{
		id: 'category-balloon',
		num: '01',
		title: 'Balloon',
		intro: [
			'記念日や特別なお誕生日に。',
			'空間を華やかに、優しく彩るバルーンギフトのコレクションです。',
			'お名前やメッセージを入れて特別な贈り物に。',
		],
		items: [
			{
				image: collectionBalloonImg1,
				title: 'バルーンブーケ',
				alt: 'バルーンブーケの画像',
				desc: ['記念日をやさしく彩る、', '華やかなバルーンギフトです。'],
			},
			{
				image: collectionBalloonImg2,
				title: 'バルーンブーケ',
				alt: 'バルーンブーケの画像',
				desc: ['淡いカラーでまとめた、', 'ふんわり華やかなデザインです。'],
			},
			{
				image: collectionBalloonImg3,
				title: 'バルーンブーケ',
				alt: 'バルーンブーケの画像',
				desc: ['ブルーを基調に仕上げた、', '爽やかで印象的なバルーンギフトです。'],
			},
			{
				image: collectionBalloonImg4,
				title: 'バルーンアレンジ',
				alt: 'バルーンアレンジの画像',
				desc: ['やさしい光沢感をまとった、', '華やかであたたかみのあるデザインです。'],
			},
			{
				image: collectionBalloonImg5,
				title: 'バルーンアレンジ',
				alt: 'バルーンアレンジの画像',
				desc: ['オーロラのきらめきが目を引く、', '軽やかで可愛らしいデザインです。'],
			},
		],
	},
	{
		id: 'category-flower',
		num: '02',
		title: 'Flower',
		intro: [
			'ドライフラワーやアーティフィシャルフラワーを使った、長く飾れるお花のギフト。',
			'母の日や、日頃の感謝を伝える日に。',
		],
		items: [
			{
				image: collectionFlowerImg1,
				title: 'しめ縄',
				alt: 'しめ縄の画像',
				desc: ['くすみ感のある色合いでまとめた、', 'やさしく上品なフラワーアイテム。'],
			},
			{
				image: collectionFlowerImg2,
				title: 'しめ縄',
				alt: 'しめ縄の画像',
				desc: ['やわらかな素材感を楽しめる、', 'やさしく華やかなリースです。'],
			},
			{
				image: collectionFlowerImg3,
				title: 'しめ縄',
				alt: 'しめ縄の画像',
				desc: ['小ぶりで飾りやすい、。', 'あたたかみのあるフラワーギフト'],
			},
			{
				image: collectionFlowerImg4,
				title: '写真立て',
				alt: '写真立ての画像',
				desc: ['やさしい彩りを添えた、', '特別感のあるフレームギフトです。'],
			},
		],
	},
	{
		id: 'category-season',
		num: '03',
		title: 'Season',
		intro: [
			'季節のイベントや暮らしに寄り添うシーズンギフト。',
			'飾って楽しめるアイテムから実用的なものまで、幅広くご用意しています。',
		],
		items: [
			{
				image: collectionSeasonImg1,
				title: 'リース',
				alt: 'リースの画像',
				desc: ['季節の彩りをそっと添える、', 'やさしく上品なリース'],
			},
			{
				image: collectionSeasonImg2,
				title: '母の日ギフト',
				alt: '母の日ギフトの画像',
				desc: ['感謝の気持ちをやさしく包む、', '華やかな母の日の贈りもの。'],
			},
			{
				image: collectionSeasonImg3,
				title: 'バルーンボックス',
				alt: 'バルーンボックスの画像',
				desc: ['ひなまつりをやさしく彩る、', '春の訪れを感じるアイテムです。'],
			},
		],
	},
];
---

<Layout {title} {description}>
	<a
		href="#main-content"
		class="absolute left-4 top-0 z-[100] -translate-y-full rounded border border-collection-ink/10 bg-[var(--color-header-bg)] px-4 py-2 text-sm text-[var(--color-header-fg)] shadow-sm transition-transform focus:translate-y-4 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
		>メインコンテンツへ</a
	>
	<Header />
	<main
		id="main-content"
		class="selection:bg-collection-accent selection:text-white bg-collection-surface overflow-x-hidden pt-14 text-collection-ink antialiased md:pt-24"
		tabindex="-1"
	>
		<section class="px-6 py-12 text-center md:py-20">
			<h1
				class="font-heading mb-6 translate-y-10 text-3xl font-normal tracking-[0.15em] text-collection-ink opacity-0 transition-[opacity,transform] duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] md:text-5xl"
				data-collection-fade
			>
				Collection
			</h1>
			<p
				class="text-xs leading-loose tracking-widest text-collection-muted opacity-0 transition-[opacity,transform] delay-100 duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] md:text-sm translate-y-10 md:delay-150"
				data-collection-fade
			>
				横にスクロールして、ギフトアイテムをご覧ください。<br class="hidden md:block" />
				詳細はオンラインショップにてご案内しております。
			</p>
		</section>

		{
			categories.map((cat) => (
				<section
					id={cat.id}
					class="w-full border-t border-collection-ink/[0.03] py-10 md:py-10 lg:py-32"
					aria-labelledby={`heading-${cat.id}`}
				>
					<div class="mx-auto flex max-w-[1600px] flex-col gap-10 px-6 md:flex-row md:gap-16 md:px-12 lg:gap-24">
						<div class="relative w-full shrink-0 md:w-[30%]">
							<div
								class="translate-y-10 opacity-0 transition-[opacity,transform] duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] md:sticky md:top-36"
								data-collection-fade
							>
								<span class="font-heading mb-4 block text-xs uppercase tracking-[0.3em] text-collection-muted">
									{cat.num}. Category
								</span>
								<h2
									id={`heading-${cat.id}`}
									class="font-heading mb-6 text-4xl tracking-widest text-collection-ink md:text-5xl lg:text-6xl"
								>
									{cat.title}
								</h2>
								<p class="mb-8 text-sm leading-[2] tracking-wide text-collection-ink/80 whitespace-pre-line">
									{cat.intro.join('\n')}
								</p>
								<div class="hidden items-center gap-4 text-xs tracking-widest text-collection-muted opacity-70 md:flex">
									<span>SCROLL</span>
									<div class="relative h-px w-16 overflow-hidden bg-collection-muted/30">
										<div
											class="absolute inset-y-0 left-0 w-1/3 animate-[collection-scroll-right_2s_cubic-bezier(0.4,0,0.2,1)_infinite] bg-collection-muted"
										/>
									</div>
								</div>
							</div>
						</div>

						<div
							class="-mx-6 w-full translate-y-10 px-6 opacity-0 transition-[opacity,transform] delay-200 duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] md:mx-0 md:w-[70%] md:px-0 md:delay-300"
							data-collection-fade
						>
							<div class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-10 [-ms-overflow-style:none] [scrollbar-width:none] md:gap-8 [&::-webkit-scrollbar]:hidden">
								{cat.items.map((item) => (
									<a
										href={baseShop}
										target="_blank"
										rel="noopener noreferrer"
										class="group block w-[75%] shrink-0 snap-start sm:w-[45%] lg:w-[22rem]"
									>
										<div class="relative mb-5 aspect-[3/4] w-full overflow-hidden rounded-sm bg-collection-fill">
											<img
												src={item.image?.src ?? `https://picsum.photos/seed/${item.seed}/600/800`}
												alt={item.alt}
												width={item.image?.width ?? 600}
												height={item.image?.height ?? 800}
												class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
												loading="lazy"
												decoding="async"
											/>
											<div class="pointer-events-none absolute inset-0 bg-collection-ink/0 transition-colors duration-500 group-hover:bg-collection-ink/5" />
										</div>
										<div class="flex flex-col">
											<h3 class="font-heading mb-2 text-lg tracking-wider text-collection-ink md:text-xl">
												{item.title}
											</h3>
											<p class="text-xs leading-relaxed tracking-widest text-collection-muted whitespace-pre-line">
												{item.desc.join('\n')}
											</p>
										</div>
									</a>
								))}
								<div class="w-1 shrink-0 md:hidden" aria-hidden="true" />
							</div>
						</div>
					</div>
				</section>
			))
		}

		<OnlineStore />
	</main>
	<Footer />
</Layout>

<script>
	import { initCollectionPage } from '../js/collection-page.js';
	initCollectionPage();
</script>
