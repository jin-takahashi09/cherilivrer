---
import '../styles/global.css';

interface Props {
	/** 未指定時はトップ用のデフォルト */
	title?: string;
	description?: string;
	/** true のとき検索結果に出したくないページ（404 等） */
	noindex?: boolean;
	/** ページ固有の構造化データ（JSON-LD） */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title: titleProp,
	description: descriptionProp,
	noindex = false,
	jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const hasValidSite = site.hostname !== 'example.com';
const canonicalURL = hasValidSite ? new URL(Astro.url.pathname, site) : undefined;
const defaultTitle = 'Cheri Livrer | 手作りバルーン・フラワーギフト';
const defaultDescription =
	'記念日や特別な日に贈る、手作りのバルーン・フラワーギフト。Cheri Livrer（シェリリヴレ）のコンセプトと作品をご紹介します。';
const title = titleProp ?? defaultTitle;
const description = descriptionProp ?? defaultDescription;
const ogImage = hasValidSite ? new URL('/ogp.jpg', site).href : undefined;
const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Cheri Livrer',
	url: site.href,
	inLanguage: 'ja',
};
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Cheri Livrer',
	url: site.href,
	logo: new URL('/favicon.svg', site).href,
	sameAs: [
		'https://www.instagram.com/cheri_livrer',
		'https://lin.ee/m3M0UIf',
	],
};
const jsonLdList = [
	websiteJsonLd,
	organizationJsonLd,
	...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f9f7f2" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
		{!noindex && canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
		{canonicalURL && <link rel="alternate" hreflang="ja" href={canonicalURL.href} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		{canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
		<meta property="og:site_name" content="Cheri Livrer" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:alt" content="Cheri Livrer のブランドイメージ" />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		{ogImage && <meta name="twitter:image:alt" content="Cheri Livrer のブランドイメージ" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			!noindex &&
				jsonLdList.map((entry) => (
					<script type="application/ld+json" set:html={JSON.stringify(entry)} />
				))
		}
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #f9f7f2;
	}
</style>
